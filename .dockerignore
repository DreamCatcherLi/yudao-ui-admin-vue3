# 依赖目录
node_modules
bower_components

# 版本控制
.git
.gitignore
.hg
.svn

# 日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 生产构建目录 (如果你是多阶段构建，或者本地已有dist，可以忽略)
dist
build

# 环境变量与敏感信息 (非常重要！防止密钥泄露)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets

# IDE 和编辑器文件
.idea
.vscode
*.swp
.DS_Store
Thumbs.db

# Docker 本身文件 (防止递归)
Dockerfile
.dockerignore